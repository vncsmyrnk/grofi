{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "types": ["@girs/gjs", "@girs/gio-2.0", "@girs/gnome-shell/ambient"],
